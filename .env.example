# Email delivery for the "Request a Custom Quote" form (api/quote.ts)
#
# Local:   copy this file to  .env.local  (git-ignored), fill it in, then restart `npm run dev`.
# Vercel:  add the same variables under Project > Settings > Environment Variables, then redeploy.
#
# Do NOT prefix these with VITE_ - that would publish the password to every visitor's browser.

# The Gmail account that sends the mail (also the default inbox that receives quotes).
SMTP_USER=businessgroupikasle@gmail.com

# A Gmail *App Password*, not the normal Gmail password:
#   1. Turn on 2-Step Verification for the account  (myaccount.google.com/security)
#   2. Open myaccount.google.com/apppasswords, create one called "Printhub website"
#   3. Paste the 16 characters here (spaces are fine)
SMTP_PASS=

# Optional: deliver quotes to a different inbox (default: businessgroupikasle@gmail.com)
# MAIL_TO=
